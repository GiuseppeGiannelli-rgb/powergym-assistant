# Provider: "ollama" (locale, gratis) oppure "openai"
PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3
# Qwen3: true disattiva il "ragionamento" (risposte più rapide)
QWEN_NO_THINK=true

# OpenAI (quando avrai la chiave)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Creato da: poetry run python create_assistant.py (con PROVIDER=openai)
VECTOR_STORE_ID=

# Resend (https://resend.com) - facoltativo: senza chiave le email vengono salvate in outbox/
RESEND_KEY=
EMAIL_FROM=onboarding@resend.dev
